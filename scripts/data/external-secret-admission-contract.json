{
  "ValidatingAdmissionPolicy": {
    "failurePolicy": "Fail",
    "matchConstraints": {
      "resourceRules": [
        {
          "apiGroups": [
            "external-secrets.io"
          ],
          "apiVersions": [
            "v1"
          ],
          "operations": [
            "CREATE",
            "UPDATE"
          ],
          "resources": [
            "externalsecrets"
          ]
        }
      ]
    },
    "validations": [
      {
        "expression": "has(object.spec.secretStoreRef) && has(object.spec.secretStoreRef.kind) && object.spec.secretStoreRef.kind == 'ClusterSecretStore' && object.spec.secretStoreRef.name == 'onepassword-connect'",
        "message": "ExternalSecrets must use ClusterSecretStore onepassword-connect."
      },
      {
        "expression": "(has(object.metadata.annotations) && 'anton.wcygan.net/secret-refresh-class' in object.metadata.annotations && object.metadata.annotations['anton.wcygan.net/secret-refresh-class'] in ['stable', 'development']) || variables.legacyMetadataOnly",
        "message": "ExternalSecrets must declare a stable or development refresh class."
      },
      {
        "expression": "(object.spec.refreshPolicy == 'OnChange' || (object.spec.refreshPolicy == 'Periodic' && has(object.spec.refreshInterval) && duration(object.spec.refreshInterval) >= duration('24h'))) || variables.legacyMetadataOnly",
        "message": "ExternalSecrets must use OnChange or a Periodic interval of at least 24h."
      },
      {
        "expression": "!has(object.spec.data) || object.spec.data.all(entry, has(entry.remoteRef) && has(entry.remoteRef.key) && entry.remoteRef.key.matches('^[^/\\\\s]+/[^/\\\\s]+$') && !has(entry.remoteRef.property))",
        "message": "Each direct 1Password reference must use one item/field key without property."
      },
      {
        "expression": "!has(object.spec.dataFrom) || object.spec.dataFrom.all(entry, has(entry.extract) && has(entry.extract.key) && entry.extract.key.matches('^[^/\\\\s]+$'))",
        "message": "dataFrom supports one non-empty extract item only."
      }
    ],
    "variables": [
      {
        "name": "legacyMetadataOnly",
        "expression": "request.operation == 'UPDATE' && oldObject != null && has(object.metadata.annotations) && 'anton.wcygan.net/preserve-legacy-spec' in object.metadata.annotations && object.metadata.annotations['anton.wcygan.net/preserve-legacy-spec'] == 'true' && has(oldObject.spec.refreshPolicy) && oldObject.spec.refreshPolicy == 'Periodic' && has(oldObject.spec.refreshInterval) && duration(oldObject.spec.refreshInterval) == duration('1h') && object.spec == oldObject.spec"
      }
    ]
  },
  "ValidatingAdmissionPolicyBinding": {
    "policyName": "external-secret-onepassword-guard",
    "validationActions": [
      "Deny"
    ]
  }
}
